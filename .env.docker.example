# Copy to .env on the deployment server and set real secrets.
# Do not commit real .env values.

# Published host ports
CLIENT_PUBLISH_PORT=11000
SERVER_PUBLISH_PORT=11100
PGADMIN_PUBLISH_PORT=11300

# PostgreSQL container bootstrap
POSTGRES_DATA_PATH=./DB/postgres
POSTGRES_DB=assetmanager_db
POSTGRES_USER=assetmanager_user
POSTGRES_PASSWORD=change_me_strong_password

# Public app/API origins
FRONTEND_URL=http://your-org-host:11000
ALLOWED_ORIGINS=http://your-org-host:11000
VITE_API_URL=http://your-org-host:11100
VITE_PUBLIC_APP_ORIGIN=http://your-org-host:11000

# Client image build args
VITE_BACKEND_API_KEY=
VITE_AUTH_AUTHORITY=
VITE_CLIENT_ID=
VITE_ORG_ID=
VITE_PROJECT_ID=
VITE_CALLBACK_PATH=/callback
VITE_LOGOUT_PATH=/login
VITE_OTEL_GRAFANA_ENABLED=false
VITE_OTEL_EXPORTER_ENDPOINT=http://your-org-host:14318/v1/traces
VITE_GRAFANA_DASHBOARD_URL_FOR_ITOPS=http://your-org-host:11200

# Server authNexus / JWT validation
AUTH_ENABLED=false
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_PROJECT_ID=
AUTH_AUDIENCE=
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_AUTHORITY=

# Server runtime
ENV=production
OTEL_GRAFANA_ENABLED=true
LOKI_BASE_URL=http://loki:3100

# Optional email service
EMAIL_SERVICE_URL=
BACKEND_API_KEY_EMAIL_NOTIFICATION=
NOTIFICATIONS_ENABLED=false

# Optional backend API protection
BACKEND_API_KEY=
ROLE_BOOTSTRAP_SECRET=

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin_password
