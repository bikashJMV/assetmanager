# Copy to `.env` and fill in. Vite only exposes variables prefixed with VITE_.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# FastAPI backend origin (used for admin endpoints like /analysis).
VITE_API_URL=http://localhost:8000

# Optional: public origin for QR code links. Use when you develop on localhost but scan from another device:
#   1. Find your PC LAN IP (e.g. 192.168.1.10).
#   2. Set: VITE_PUBLIC_APP_ORIGIN=http://192.168.1.10:5173
#   3. Run `npm run dev` — Vite is configured with host: true so the phone can open that URL.
# Production builds embed https://web-assetmanager.vercel.app in QRs unless you override:
# VITE_PUBLIC_APP_ORIGIN=https://your-fork-or-staging.example.com
