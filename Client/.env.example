VITE_API_URL=http://your-org-host:11100
VITE_PUBLIC_APP_ORIGIN=http://your-org-host:11000


# authNexus Configuration
# ----------------------------------------------------------------------
VITE_AUTH_AUTHORITY=my-auth-nexus-url
VITE_CLIENT_ID=my-client-id
VITE_ORG_ID=my-org-id
VITE_PROJECT_ID=my-project-id
