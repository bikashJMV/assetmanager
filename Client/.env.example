# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: override the origin embedded in generated QR links (useful for LAN testing)
# Example: http://192.168.1.50:5173
VITE_PUBLIC_APP_ORIGIN=http://localhost:5173

# Optional: main FastAPI server base URL (used by Analysis and telemetry token issuance)
VITE_API_URL=http://localhost:8000

# Optional: browser telemetry (requires TelemetryServer + main Server config)
VITE_TELEMETRY_ENABLED=false
VITE_TELEMETRY_INGEST_URL=http://localhost:8010/telemetry/events
VITE_TELEMETRY_TOKEN_URL=http://localhost:8000/telemetry/ingest-token
VITE_TELEMETRY_ENV=local

