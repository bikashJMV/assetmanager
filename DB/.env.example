# Copy to .env and set strong passwords. Never commit .env.

# PostgreSQL (container bootstrap)
POSTGRES_DB=assetmanager_db
POSTGRES_USER=assetmanager_user
POSTGRES_PASSWORD=change_me_strong_password

# Host port Postgres listens on (optional; default 5432)
# [unused] POSTGRES_PUBLISH_PORT=5432

# pgAdmin web UI
# [unused] PGADMIN_DEFAULT_EMAIL=admin@example.com
# [unused] PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# Host port pgAdmin listens on (optional; default 5050)
# [unused] PGADMIN_PUBLISH_PORT=5050
