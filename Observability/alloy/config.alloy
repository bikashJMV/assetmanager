// ─── Phase 0: Loki write target ────────────────────────────────────────────
// All log sources and metric pipelines ultimately push here
loki.write "local" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}

// ─── Phase 1: Tail AMS Server log file → Loki ─────────────────────────────
// Requires: ../logs/ams_server.log to exist (start server with stdout redirect)
local.file_match "ams_server" {
  path_targets = [{"__path__" = "/app/logs/ams_server.log"}]
}

loki.source.file "ams_server" {
  targets    = local.file_match.ams_server.targets
  forward_to = [loki.process.add_ams_labels.receiver]
}

loki.process "add_ams_labels" {
  stage.static_labels {
    values = { service = "ams-server", env = "local" }
  }
  stage.regex {
    expression = "^(?P<level>INFO|ERROR|WARNING|DEBUG|CRITICAL):"
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.local.receiver]
}

// ─── Phase 1: Tail TelemetryServer log file → Loki ────────────────────────
// Requires: ../logs/telemetry_server.log to exist
local.file_match "telemetry_server" {
  path_targets = [{"__path__" = "/app/logs/telemetry_server.log"}]
}

loki.source.file "telemetry_server" {
  targets    = local.file_match.telemetry_server.targets
  forward_to = [loki.process.add_telemetry_labels.receiver]
}

loki.process "add_telemetry_labels" {
  stage.static_labels {
    values = { service = "telemetry-server", env = "local" }
  }
  stage.regex {
    expression = "^(?P<level>INFO|ERROR|WARNING|DEBUG|CRITICAL):"
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.local.receiver]
}

// ─── Phase 2: OTLP receiver (gRPC + HTTP with CORS) ───────────────────────
// gRPC  :4317 — AMS Server OTel auto-instrument
// HTTP  :4318 — OTel Web SDK from the React browser client
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http {
    endpoint = "0.0.0.0:4318"
    cors {
      allowed_origins = ["http://localhost:5173", "http://localhost:3000"]
      allowed_headers = ["*"]
      max_age         = 7200
    }
  }
  output {
    traces  = [otelcol.exporter.otlp.local_tempo.input]
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

// ─── Phase 2: Forward traces → Tempo (inside Docker network) ──────────────
otelcol.exporter.otlp "local_tempo" {
  client { 
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}

// ─── Phase 3: Prometheus metrics pipeline (from OTLP receiver) ────────────
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.local.receiver]
}

// ─── Phase 3: Scrape AMS Server /metrics (added after Phase 3 setup) ──────
prometheus.scrape "ams_server" {
  targets      = [{"__address__" = "host.docker.internal:8000"}]
  metrics_path = "/metrics"
  forward_to   = [prometheus.remote_write.local.receiver]
}

// ─── Phase 3: Scrape TelemetryServer /telemetry/metrics-prom ──────────────
prometheus.scrape "telemetry_server" {
  targets      = [{"__address__" = "host.docker.internal:8010"}]
  metrics_path = "/telemetry/metrics-prom"
  forward_to   = [prometheus.remote_write.local.receiver]
}

// ─── Remote write → Prometheus ────────────────────────────────────────────
prometheus.remote_write "local" {
  endpoint { url = "http://prometheus:9090/api/v1/write" }
}