{
  "title": "Telemetry Event Stream (Logs)",
  "tags": [
    "logs",
    "ams"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Log Volume Over Time",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({service=~\"ams-server|telemetry-server\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1
          }
        }
      }
    },
    {
      "type": "logs",
      "title": "Live Application Logs",
      "gridPos": {
        "h": 15,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "{service=~\"ams-server|telemetry-server\"}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
