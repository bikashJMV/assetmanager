# Base URL of the SPA for QR scan links in server-generated PDFs (Settings.FRONTEND_URL). Prefer this over VITE_FRONTEND_URL for the server.
# Local dev example: http://localhost:5174
FRONTEND_URL=https://web-assetmanager.vercel.app
VITE_FRONTEND_URL=https://web-assetmanager.vercel.app
VITE_ALLOWED_ORIGINS=https://web-assetmanager.vercel.app,http://localhost:5173,http://localhost:8010/telemetry/events,http://115.241.70.253:10100
VITE_ENV=Local # production
Port=8000
VITE_BACKEND_API_KEY=some_key
# ROLE_BOOTSTRAP_SECRET=make_user_admin_or_it_ops_2026 
# Email service configuration
EMAIL_SERVICE_URL=https://email-notification-ams.vercel.app
BACKEND_API_KEY_EMAIL_NOTIFICATION=some-api-key-for-email-service
NOTIFICATIONS_ENABLED=false #true

# authNexus Configuration
# ----------------------------------------------------------------------
VITE_AUTH_AUTHORITY=http://115.241.70.253:10100
VITE_CLIENT_ID=some_client_id_from_zitadel
VITE_ORG_ID=some_org_id_from_zitadel
VITE_PROJECT_ID=some_project_id_from_zitadel

# New-style auth vars (used by AuthMiddleware + core/authnexus.py)
AUTH_ENABLED=true
AUTH_JWKS_URL=http://115.241.70.253:10100/api/v1/auth/jwks
AUTH_ISSUER=authNexus-Gateway
AUTH_AUDIENCE=
AUTH_PROJECT_ID=some_project_id_from_zitadel
AUTH_PROJECT_ID_CLAIM=project_id
AUTH_CLOCK_SKEW_SECONDS=30

# Used by legacy core/auth.py (assignments.py, employees.py, observability.py)
AUTH_AUTHORITY=http://115.241.70.253:10100


# Grafana telemetry true/false  
OTEL_GRAFANA_ENABLED=true  

# my postgres database configuration own db
DB_PROVIDER=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=assetmanager_db
POSTGRES_USER=some_assetmanager_user_detaile
POSTGRES_PASSWORD=password_of_local_setup_db