# Supabase (required)
# Use the service-role key on the server only. Never expose it to the browser.
SUPABASE_URL=
SUPABASE_KEY=

# Frontend origin used for server-generated QR links
FRONTEND_URL=http://localhost:5173

# CORS allowlist (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: shared key for protecting server routes when deployed publicly
BACKEND_API_KEY=

# Server-only: secret for POST /internal/bootstrap-role (JSON body: email + role admin|it_ops).
# Header: X-Bootstrap-Secret or Authorization: Bearer <same>. Leave empty to disable (503).
ROLE_BOOTSTRAP_SECRET=

# local | production
ENV=local

# ── Notification / Email microservice (THIS repo: AMS Server / BFF only) ─────
# The BFF calls your separate email service over HTTP. It does NOT use Nodemailer.
# Do NOT put only SUPABASE_* here — you still need the three lines below.
#
# BACKEND_API_KEY_EMAIL_NOTIFICATION must match the email microservice's API_KEY (X-API-Key),
# which is usually a dedicated secret string — NOT the Supabase service_role JWT.
# EMAIL_SERVICE_API_KEY is accepted temporarily as a legacy fallback during migration.
#
# Set NOTIFICATIONS_ENABLED=true to dispatch real emails.
# EMAIL_SERVICE_URL: no trailing slash
#   Local:  http://localhost:8000
#   Prod:   https://email-notification-ams.vercel.app
EMAIL_SERVICE_URL=http://localhost:8000
BACKEND_API_KEY_EMAIL_NOTIFICATION=
NOTIFICATIONS_ENABLED=false

# Grafana telemetry enable/disable
OTEL_GRAFANA_ENABLED=true 

# Observability (Loki Integration)
LOKI_BASE_URL=http://localhost:3100