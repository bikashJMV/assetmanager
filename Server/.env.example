# Supabase (required)
# Use the service-role key on the server only. Never expose it to the browser.
SUPABASE_URL=
SUPABASE_KEY=

# Frontend origin used for server-generated QR links
FRONTEND_URL=http://localhost:5173

# CORS allowlist (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: shared key for protecting server routes when deployed publicly
BACKEND_API_KEY=

# local | production
ENV=local

# Telemetry integration (optional)
TELEMETRY_SERVER_BASE_URL=http://localhost:8010

# Used by this server to authenticate when it calls TelemetryServer protected query endpoints.
TELEMETRY_ITOPS_QUERY_KEY_NEW=

# Used to sign browser ingest tokens (must match TelemetryServer TELEMETRY_INGEST_TOKEN_SECRET).
TELEMETRY_INGEST_TOKEN_SECRET=
TELEMETRY_TOKEN_TTL_SECONDS=600
TELEMETRY_ENV=local

