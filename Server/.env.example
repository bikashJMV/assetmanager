# QR scan URL base for PDFs — must match the SPA you open locally (see Client .env.local).
FRONTEND_URL=http://your-org-host:11000
ALLOWED_ORIGINS=http://your-org-host:11000
VITE_ENV=Local # production
Port=server-port 
VITE_BACKEND_API_KEY=backend-api-key-secret
# Email service configuration
EMAIL_SERVICE_URL=https://email-notification-ams.vercel.app
BACKEND_API_KEY_EMAIL_NOTIFICATION=api-key-for-email-service
NOTIFICATIONS_ENABLED=true #true

# authNexus Configuration
# ----------------------------------------------------------------------
# New-style auth vars (used by AuthMiddleware + core/authnexus.py)
AUTH_ENABLED=true
AUTH_JWKS_URL=auth-jwks-url
# AUTH_ISSUER=authNexus-Gateway
AUTH_ISSUER=auth-issuer
AUTH_PROJECT_ID=auth-project-id
AUTH_PROJECT_ID_CLAIM=auth-project-id-claim
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_AUDIENCE=auth-audience

# authNexus Admin (for sync)
AUTHNEXUS_ADMIN_USER=admin-username
AUTHNEXUS_ADMIN_PASSWORD=admin-password
AUTHNEXUS_ORG_ID=authnexus-org-id

# Used by legacy core/auth.py (assignments.py, employees.py, observability.py)
AUTH_AUTHORITY=auth-authority


# Grafana telemetry true/false  
OTEL_GRAFANA_ENABLED=true  
ASSET_EXPORT_ENABLED=true
LOKI_BASE_URL=http://loki:3100

# my postgres database configuration own db
DB_PROVIDER=db-name
POSTGRES_HOST=db-host
POSTGRES_PORT=db-port
POSTGRES_DB=db-name
POSTGRES_USER=db-user
POSTGRES_PASSWORD=db-password
