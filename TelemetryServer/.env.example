# Telemetry database (required)
TELEMETRY_DATABASE_URL=
TELEMETRY_DATABASE_SCHEMA=telemetry
TELEMETRY_DB_POOL_MIN_SIZE=1
TELEMETRY_DB_POOL_MAX_SIZE=10
TELEMETRY_DB_SSL=true

# local | production label
TELEMETRY_ENV=local

# Ingest auth
TELEMETRY_INGEST_SERVER_TOKEN=
TELEMETRY_INGEST_TOKEN_SECRET=

# Query auth (note the current variable name in code)
# Until this is aligned with the main Server config, set this value to the same string as Server TELEMETRY_ITOPS_QUERY_KEY_NEW.
TELEMETRY_ITOPS_QUERY_KEY_NEW_NEW=

# Optional: CORS allowlist (comma-separated)
TELEMETRY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

