# Dedicated Supabase project (Postgres). Use the service-role / direct connection string from Project Settings → Database.
TELEMETRY_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Optional: default telemetry
TELEMETRY_DATABASE_SCHEMA=telemetry

# Pool size (single process)
TELEMETRY_DB_POOL_MIN_SIZE=1
TELEMETRY_DB_POOL_MAX_SIZE=10
# Set to false only for local Postgres without TLS
TELEMETRY_DB_SSL=true

TELEMETRY_ENV=local

TELEMETRY_QUEUE_MAX_SIZE=2000
TELEMETRY_QUEUE_WORKERS=2
TELEMETRY_EVENT_MAX_BATCH=100
TELEMETRY_EVENT_MAX_BYTES=16384
TELEMETRY_INGEST_MAX_BATCH_BYTES=1048576

# For server-to-server ingest
TELEMETRY_INGEST_SERVER_TOKEN=replace_me

# For short-lived browser ingest tokens signed by main backend
TELEMETRY_INGEST_TOKEN_SECRET=replace_me

# IT Ops query auth (phase 1 simple key)
TELEMETRY_ITOPS_QUERY_KEY=replace_me

TELEMETRY_SAMPLE_SERVER_SUCCESS=0.25
TELEMETRY_SAMPLE_CLIENT_DATA_SUCCESS=0.20
TELEMETRY_SAMPLE_CLIENT_ENGAGEMENT=0.10
TELEMETRY_CRITICAL_SERVER_ROUTES=/assets,/assets/:id,/employee,/analysis
TELEMETRY_CRITICAL_CLIENT_OPERATIONS=fn_assign_asset,fn_return_asset,fn_set_employee_role,fn_public_scan_asset

TELEMETRY_RATE_LIMIT_PER_MINUTE=600
TELEMETRY_RATE_LIMIT_BURST=200

TELEMETRY_RETAIN_SUCCESS_DAYS=30
TELEMETRY_RETAIN_ERROR_DAYS=60
TELEMETRY_RETAIN_KEYS_HOURS=72
TELEMETRY_RETAIN_GENERAL_DAYS=30
-----------------------------------------------------------

TELEMETRY_PORT=8010

# Supabase
SUPABASE_URL=https://twdumuonmxnhrwlspyox.supabase.co # 1st database for main app
# this is our secret api key for the main app

# Ingest auth
TELEMETRY_INGEST_SERVER_TOKEN=replace_with_long_random_secret
TELEMETRY_INGEST_TOKEN_SECRET=replace_with_long_random_secret

# Query auth (phase 1)
TELEMETRY_ITOPS_QUERY_KEY=replace_with_long_random_secret

# Queue + payload limits
TELEMETRY_QUEUE_MAX_SIZE=2000
TELEMETRY_QUEUE_WORKERS=2
TELEMETRY_EVENT_MAX_BATCH=100
TELEMETRY_EVENT_MAX_BYTES=16384
TELEMETRY_INGEST_MAX_BATCH_BYTES=1048576

# Sampling
TELEMETRY_SAMPLE_SERVER_SUCCESS=0.25
TELEMETRY_SAMPLE_CLIENT_DATA_SUCCESS=0.20
TELEMETRY_SAMPLE_CLIENT_ENGAGEMENT=0.10
TELEMETRY_CRITICAL_SERVER_ROUTES=/assets,/assets/:id,/employee,/analysis
TELEMETRY_CRITICAL_CLIENT_OPERATIONS=fn_assign_asset,fn_return_asset,fn_set_employee_role,fn_public_scan_asset

TELEMETRY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TELEMETRY_LOG_LEVEL=DEBUG

# Rate limiting
TELEMETRY_RATE_LIMIT_PER_MINUTE=600
TELEMETRY_RATE_LIMIT_BURST=200
# Retention
TELEMETRY_RETAIN_SUCCESS_DAYS=30
TELEMETRY_RETAIN_ERROR_DAYS=60
TELEMETRY_RETAIN_KEYS_HOURS=72


